      "id": "1",
      "front": "1",
      "meaning": "Catchall for general errors",
      "example": "let \"var1 = 1/0\"",
      "notes": "Miscellaneous errors, such as “divide by zero” and other impermissible operations"
    },
    {
      "id": "2",
      "front": "2",
      "meaning": "Misuse of shell builtins",
      "example": "empty_function() {",
      "notes": "Missing keyword or command, or permission problem (and diff return code on a failed binary file comparison)"
    },
    {
      "id": "126",
      "front": "126",
      "meaning": "Command invoked cannot execute",
      "example": "/dev/null",
      "notes": "Permission problem or command is not an executable. Found the file — cannot run it."
    },
    {
      "id": "127",
      "front": "127",
      "meaning": "Command not found",
      "example": "Illegal_command",
      "notes": "Possible problem with $PATH or a typo. Never found a command."
    },
    {
      "id": "128",
      "front": "128",
      "meaning": "Invalid argument to exit",
      "example": "exit 3.14159",
      "notes": "exit takes only integer args in the range 0–255"
    },
    {
      "id": "128n",
      "front": "128+n",
      "meaning": "Fatal error signal n",
      "example": "kill -9 $PPID of script",
      "notes": "$? returns 137 when n = 9 (128 + 9)"
    },
    {
      "id": "130",
      "front": "130",
      "meaning": "Script terminated by Control-C",
      "example": "Ctrl-C",
      "notes": "SIGINT is signal 2 → 130 = 128 + 2"
    },
    {
      "id": "255",
      "front": "255",
      "meaning": "Exit status out of range",
      "example": "exit -1",
      "notes": "exit takes only integer args in the range 0–255"
    }
  ]
