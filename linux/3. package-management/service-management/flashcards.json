{
  "title": "Service management",
  "subtitle": "init.d scripts and systemd units — flip to reveal meaning, example, and notes",
  "frontLabel": "Command / concept",
  "modeForward": "Term → meaning",
  "modeReverse": "Meaning → term",
  "cards": [
    {
      "id": "systemd-role",
      "front": "systemd",
      "meaning": "Default modern init system and service manager; declarative unit files + systemctl",
      "example": "",
      "notes": "More than PID 1: suite includes journald (logs), logind (sessions), networkd (network)."
    },
    {
      "id": "initd-role",
      "front": "init.d",
      "meaning": "Legacy Unix-style manager: a shell script per service in /etc/init.d/",
      "example": "",
      "notes": "Memory hook: init.d = shell script per service. systemd = declarative unit file + systemctl."
    },
    {
      "id": "initd-syntax",
      "front": "/etc/init.d/<command> <option>",
      "meaning": "SysV-style: script name plus start|stop|reload|restart|force-reload",
      "example": "/etc/init.d/nginx start",
      "notes": "The file is the API — a case on $1. Unknown options print usage and exit 1."
    },
    {
      "id": "initd-start",
      "front": "/etc/init.d/nginx start",
      "meaning": "Start the service via its SysV script",
      "example": "/etc/init.d/nginx start",
      "notes": "On some systems service nginx start wraps the same scripts."
    },
    {
      "id": "initd-stop",
      "front": "/etc/init.d/nginx stop",
      "meaning": "Stop the service via its SysV script",
      "example": "/etc/init.d/nginx stop",
      "notes": ""
    },
    {
      "id": "initd-restart",
      "front": "/etc/init.d/nginx restart",
      "meaning": "Restart the service via its SysV script",
      "example": "/etc/init.d/nginx restart",
      "notes": ""
    },
    {
      "id": "initd-reload",
      "front": "/etc/init.d/nginx reload",
      "meaning": "Reread config without a full stop",
      "example": "/etc/init.d/nginx reload",
      "notes": ""
    },
    {
      "id": "initd-force-reload",
      "front": "/etc/init.d/nginx force-reload",
      "meaning": "Force-reload option for the SysV script",
      "example": "/etc/init.d/nginx force-reload",
      "notes": ""
    },
    {
      "id": "system-instance-conf",
      "front": "systemd system instance config",
      "meaning": "Reads system.conf and system.conf.d/",
      "example": "",
      "notes": ""
    },
    {
      "id": "user-instance-conf",
      "front": "systemd user instance config",
      "meaning": "Reads user.conf and user.conf.d/",
      "example": "",
      "notes": ""
    },
    {
      "id": "targets",
      "front": ".target units",
      "meaning": "Group units and mark boot stages; replace SysV runlevels",
      "example": "multi-user.target; runlevel3.target still exists for compatibility",
      "notes": "Servers typically want multi-user.target."
    },
    {
      "id": "path-usr-lib",
      "front": "/usr/lib/systemd/system/",
      "meaning": "Unit files shipped by packages (RPM/deb)",
      "example": "nginx, Apache, MySQL units",
      "notes": "Memory hook: vendor = /usr/lib/..."
    },
    {
      "id": "path-run",
      "front": "/run/systemd/system/",
      "meaning": "Unit files created at runtime (tmp, volatile)",
      "example": "",
      "notes": "Memory hook: runtime = /run/..."
    },
    {
      "id": "path-etc",
      "front": "/etc/systemd/system/",
      "meaning": "Admin / user-created units",
      "example": "/etc/systemd/system/tomcat.service",
      "notes": "Memory hook: you customize or add = /etc/systemd/system/."
    },
    {
      "id": "suffix-service",
      "front": ".service",
      "meaning": "Daemons / long-running programs",
      "example": "name.service",
      "notes": ""
