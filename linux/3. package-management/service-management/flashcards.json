    {
      "id": "section-unit",
      "front": "[Unit]",
      "meaning": "Metadata and dependencies — who I wait for",
      "example": "",
      "notes": ""
    },
    {
      "id": "section-service",
      "front": "[Service]",
      "meaning": "How the process runs — what systemd supervises",
      "example": "",
      "notes": ""
    },
    {
      "id": "section-install",
      "front": "[Install]",
      "meaning": "What systemctl enable / disable does — which target pulls this unit in",
      "example": "WantedBy=multi-user.target",
      "notes": "WantedBy=multi-user.target = start on a normal server boot."
    },
    {
      "id": "description",
      "front": "Description=",
      "meaning": "Human-readable summary",
      "example": "Description=Tomcat Application server",
      "notes": "[Unit]"
    },
    {
      "id": "documentation",
      "front": "Documentation=",
      "meaning": "man pages or URLs",
      "example": "",
      "notes": "[Unit]"
    },
    {
      "id": "requires",
      "front": "Requires=",
      "meaning": "Strong dependency — if they fail, this fails",
      "example": "",
      "notes": "Requires is strict; Wants is polite."
    },
    {
      "id": "wants",
      "front": "Wants=",
      "meaning": "Weak dependency — start them, but they need not succeed",
      "example": "",
      "notes": "Wants is polite; Requires is strict."
    },
    {
      "id": "bindsto",
      "front": "BindsTo=",
      "meaning": "If the bound unit stops, this stops too",
      "example": "",
      "notes": "[Unit]"
    },
    {
      "id": "partof",
      "front": "PartOf=",
      "meaning": "Stopping/restarting the listed units also stops/restarts this one",
      "example": "",
      "notes": "[Unit]"
    },
    {
      "id": "conflicts",
      "front": "Conflicts=",
      "meaning": "Cannot be active at the same time as the listed units",
      "example": "",
      "notes": "[Unit]"
    },
    {
      "id": "before-after",
      "front": "Before= / After=",
      "meaning": "Ordering — this starts before / after those units",
      "example": "After=network.target",
      "notes": "After=network.target = wait until networking is up."
    },
    {
      "id": "onfailure",
      "front": "OnFailure=",
      "meaning": "Units to start if this fails",
      "example": "",
      "notes": "[Unit]"
    },
    {
      "id": "type",
      "front": "Type=",
      "meaning": "Startup style: simple, forking, oneshot, notify, …",
      "example": "Type=forking",
      "notes": "[Service]"
    },
    {
      "id": "type-forking",
      "front": "Type=forking",
      "meaning": "The start script daemonizes — parent exits, child stays",
      "example": "Type=forking in tomcat.service",
      "notes": "Often used with PIDFile=."
    },
    {
      "id": "execstart",
      "front": "ExecStart=",
      "meaning": "Command that starts the service",
      "example": "ExecStart=/apps/tomcat/bin/startup.sh",
      "notes": "[Service]"
    },
    {
      "id": "execstart-pre-post",
      "front": "ExecStartPre= / ExecStartPost=",
      "meaning": "Commands run before / after ExecStart",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "execreload-stop",
      "front": "ExecReload= / ExecStop=",
      "meaning": "Reload / stop commands",
      "example": "ExecStop=/apps/tomcat/bin/shutdown.sh",
      "notes": "[Service]"
    },
    {
      "id": "restart",
      "front": "Restart=",
      "meaning": "What to do if the process fails or exits",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "pidfile",
      "front": "PIDFile=",
      "meaning": "File holding the daemon PID (typical with forking)",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "user-group",
      "front": "User= / Group=",
      "meaning": "Run the process as this user/group",
      "example": "User=tomcat55\nGroup=staff",
      "notes": "[Service]"
    },
    {
      "id": "workingdirectory",
      "front": "WorkingDirectory=",
      "meaning": "cwd of the process",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "environment",
      "front": "Environment=",
      "meaning": "Inline environment variables",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "environmentfile",
      "front": "EnvironmentFile=",
      "meaning": "File of KEY=value lines",
      "example": "",
      "notes": "[Service]"
    },
    {
      "id": "wantedby",
      "front": "WantedBy=",
      "meaning": "Targets that should pull this unit in when enabled",
      "example": "WantedBy=multi-user.target",
      "notes": "[Install]"
    },
    {
      "id": "requiredby",
      "front": "RequiredBy=",
      "meaning": "Targets that require this unit",
      "example": "",
      "notes": "[Install]"
    },
    {
      "id": "alias",
      "front": "Alias=",
      "meaning": "Extra names for the unit",
      "example": "",
      "notes": "[Install]"
    },
    {
      "id": "also",
      "front": "Also=",
      "meaning": "Other units to install/uninstall together",
      "example": "",
      "notes": "[Install]"
    },
    {
      "id": "systemctl-start",
      "front": "systemctl start name.service",
      "meaning": "Start the service now",
      "example": "systemctl start name.service",
      "notes": "start/stop control now; enable/disable control boot."
    },
    {
      "id": "systemctl-stop",
      "front": "systemctl stop name.service",
      "meaning": "Stop the service now",
      "example": "systemctl stop name.service",
      "notes": ""
    },
    {
      "id": "systemctl-restart",
      "front": "systemctl restart name.service",
      "meaning": "Restart the service now",
      "example": "systemctl restart name.service",
      "notes": ""
    },
    {
      "id": "systemctl-reload",
      "front": "systemctl reload name.service",
      "meaning": "Reload config if the unit supports it",
      "example": "systemctl reload name.service",
      "notes": ""
    },
    {
      "id": "systemctl-status",
      "front": "systemctl status name.service",
      "meaning": "Is it running? Recent logs?",
      "example": "systemctl status name.service",
      "notes": ""
    },
    {
      "id": "systemctl-is-active",
      "front": "systemctl is-active name.service",
      "meaning": "Exit 0 if the unit is active",
      "example": "systemctl is-active name.service",
      "notes": ""
    },
    {
      "id": "systemctl-enable",
      "front": "systemctl enable name.service",
      "meaning": "Start at boot (uses [Install] WantedBy)",
      "example": "systemctl enable name.service",
      "notes": "enable/disable = boot; start/stop = now."
    },
    {
      "id": "systemctl-disable",
      "front": "systemctl disable name.service",
      "meaning": "Do not start at boot",
      "example": "systemctl disable name.service",
      "notes": ""
    },
    {
      "id": "systemctl-daemon-reload",
      "front": "systemctl daemon-reload",
      "meaning": "Reread unit files after you edit one; then restart",
      "example": "systemctl daemon-reload",
      "notes": ""
    },
    {
      "id": "systemctl-list-units",
      "front": "systemctl list-units --type service --all",
      "meaning": "List all service units, even inactive",
      "example": "systemctl list-units --type service --all",
      "notes": ""
    }
  ]
}
